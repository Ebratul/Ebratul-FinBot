# FinBot Environment Configuration
# Copy this file to .env and fill in your actual values.

# ── API Keys ──────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
HF_TOKEN=hf_your_token_here
QDRANT_API_KEY=optional_key_here

# ── LLM ──────────────────────────────────────────────────────
GROQ_MODEL_NAME=openai/gpt-oss-20b

# ── Embedding Model ───────────────────────────────────────────
EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# ── Qdrant Vector Store ───────────────────────────────────────
# Use a local path for on-disk persistence, or set QDRANT_URL for a remote server
QDRANT_PATH=/tmp/my_lang_vs
# QDRANT_URL=http://localhost:6333   # uncomment for remote Qdrant
# QDRANT_API_KEY=                    # uncomment for Qdrant Cloud

# ── Semantic Router ───────────────────────────────────────────
SEMANTIC_ROUTER_ENCODER=sentence-transformers/all-MiniLM-L6-v2

# ── Session Rate Limiting ─────────────────────────────────────
SESSION_MAX_QUERIES=20

